<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
























<configuration>



<property>
  <name>fs.defaultFS</name>
  <value>hdfs://mycluster</value>
  <description>HDFS默认文件系统地址（nameservices）</description>
</property>

<property>
  <name>hadoop.tmp.dir</name>
  <value>/sdb1/hadoop-3.3.6/tmp</value>
  <description>Hadoop临时文件目录（软件安装目录下）</description>
</property>



<property>
  <name>hadoop.security.authentication</name>
  <value>simple</value>
  <description>认证方式：simple（简单认证，未启用Kerberos）</description>
</property>

<property>
  <name>hadoop.security.authorization</name>
  <value>false</value>
  <description>禁用授权（开发环境）</description>
</property>



<property>
  <name>hadoop.proxyuser.hdfs.hosts</name>
  <value>*</value>
  <description>允许hdfs用户从所有主机代理</description>
</property>

<property>
  <name>hadoop.proxyuser.hdfs.groups</name>
  <value>*</value>
  <description>允许hdfs用户代理所有组</description>
</property>

<property>
  <name>hadoop.proxyuser.root.hosts</name>
  <value>*</value>
</property>

<property>
  <name>hadoop.proxyuser.root.groups</name>
  <value>*</value>
</property>

<property>
  <name>hadoop.proxyuser.hive.hosts</name>
  <value>*</value>
</property>

<property>
  <name>hadoop.proxyuser.hive.groups</name>
  <value>*</value>
</property>



<property>
  <name>ha.zookeeper.quorum</name>
  <value>192.168.153.131:2181,192.168.153.132:2181,192.168.153.133:2181</value>
  <description>ZooKeeper集群地址</description>
</property>



<property>
  <name>hadoop.http.filter.enabled</name>
  <value>true</value>
  <description>启用主机访问过滤</description>
</property>



<property>
  <name>io.compression.codec.lzo.class</name>
  <value>org.apache.hadoop.io.compress.LzoCodec</value>
  <description>LZO压缩编解码器</description>
</property>

<property>
  <name>io.compression.codec.lz4.class</name>
  <value>org.apache.hadoop.io.compress.Lz4Codec</value>
  <description>LZ4压缩编解码器</description>
</property>

<property>
  <name>io.compression.codec.snappy.class</name>
  <value>org.apache.hadoop.io.compress.SnappyCodec</value>
  <description>Snappy压缩编解码器</description>
</property>

<property>
  <name>io.compression.codec.zstd.class</name>
  <value>org.apache.hadoop.io.compress.ZStandardCodec</value>
  <description>ZStandard压缩编解码器</description>
</property>

<property>
  <name>io.compression.codecs</name>
  <value>org.apache.hadoop.io.compress.GzipCodec,org.apache.hadoop.io.compress.DefaultCodec,org.apache.hadoop.io.compress.BZip2Codec,org.apache.hadoop.io.compress.Lz4Codec,org.apache.hadoop.io.compress.SnappyCodec</value>
  <description>支持的压缩编解码器</description>
</property>

<property>
  <name>io.file.buffer.size</name>
  <value>131072</value>
  <description>文件读写缓冲区大小（128KB）</description>
</property>

<property>
  <name>io.seqfile.localwrite.blocksize</name>
  <value>131072</value>
  <description>SequenceFile本地写块大小</description>
</property>



<property>
  <name>fs.trash.interval</name>
  <value>1440</value>
  <description>垃圾回收时间（分钟），1440=1天</description>
</property>

<property>
  <name>fs.trash.classpath</name>
  <value>org.apache.hadoop.fs.TrashPolicyDefault</value>
  <description>垃圾回收策略类</description>
</property>



<property>
  <name>ipc.client.connection.maxidletime</name>
  <value>30000</value>
  <description>IPC客户端连接最大空闲时间（毫秒）</description>
</property>

<property>
  <name>ipc.client.connect.max.retries</name>
  <value>10</value>
  <description>IPC客户端连接最大重试次数</description>
</property>

<property>
  <name>ipc.client.connect.retry.interval.ms</name>
  <value>1000</value>
  <description>IPC客户端连接重试间隔（毫秒）</description>
</property>

<property>
  <name>ipc.client.connect.timeout.ms</name>
  <value>10000</value>
  <description>IPC客户端连接超时（毫秒）</description>
</property>

<property>
  <name>ipc.client.kill.max</name>
  <value>10</value>
  <description>IPC客户端最大失败数</description>
</property>

<property>
  <name>ipc.server.tcpnodelay</name>
  <value>true</value>
  <description>启用TCP_NODELAY</description>
</property>

<property>
  <name>ipc.client.tcpnodelay</name>
  <value>true</value>
  <description>客户端启用TCP_NODELAY</description>
</property>



<property>
  <name>ha.zookeeper.session-timeout.ms</name>
  <value>30000</value>
  <description>ZooKeeper会话超时（毫秒）</description>
</property>

<property>
  <name>ha.zookeeper.parent-znode</name>
  <value>/hadoop-ha</value>
  <description>ZooKeeper父节点路径</description>
</property>



<property>
  <name>fs.permissions.umask-mode</name>
  <value>022</value>
  <description>文件权限掩码</description>
</property>

<property>
  <name>fs.s3.block.size</name>
  <value>134217728</value>
  <description>S3块大小（128MB）</description>
</property>

<property>
  <name>fs.har.impl</name>
  <value>org.apache.hadoop.fs.HarFileSystem</value>
  <description>Hadoop Archive文件系统</description>
</property>

<property>
  <name>har.command.script.prefix</name>
  <value>/sdb1/hadoop-3.3.6/bin/har</value>
  <description>HAR脚本前缀（软件安装目录下）</description>
</property>



<property>
  <name>file.replication</name>
  <value>2</value>
  <description>本地文件系统副本数</description>
</property>



<property>
  <name>io.native.lib.available</name>
  <value>true</value>
  <description>启用本地库</description>
</property>

</configuration>
