<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>





















<configuration>



<property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
    <description>使用YARN作为执行框架</description>
</property>



<property>
    <name>mapreduce.cluster.local.dir</name>
    <value>/sdb1/hadoop-3.3.6/mapred/local</value>
    <description>MapReduce本地目录（软件安装目录下）</description>
</property>



<property>
    <name>mapreduce.jobhistory.address</name>
    <value>192.168.153.131:10020</value>
    <description>JobHistoryServer RPC地址</description>
</property>

<property>
    <name>mapreduce.jobhistory.webapp.address</name>
    <value>192.168.153.131:19888</value>
    <description>JobHistoryServer Web界面地址</description>
</property>

<property>
    <name>mapreduce.jobhistory.keytab</name>
    <value>/etc/security/keytabs/jhs.service.keytab</value>
    <description>JobHistoryServer keytab路径（如启用Kerberos）</description>
</property>

<property>
    <name>mapreduce.jobhistory.principal</name>
    <value>jhs/_HOST@YOUR_REALM.COM</value>
    <description>JobHistoryServer principal（如启用Kerberos）</description>
</property>



<property>
    <name>mapreduce.jobhistory.done-dir</name>
    <value>hdfs://mycluster/Datas/haoranMusicPlatform/logs/mapred/history/done</value>
    <description>作业历史日志最终存储目录（HDFS）</description>
</property>

<property>
    <name>mapreduce.jobhistory.intermediate-done-dir</name>
    <value>hdfs://mycluster/Datas/haoranMusicPlatform/logs/mapred/history/intermediate</value>
    <description>作业运行中临时日志存储目录（HDFS）</description>
</property>

<property>
    <name>mapreduce.jobhistory.retention.ms</name>
    <value>604800000</value>
    <description>保留作业历史时间（毫秒），604800000=7天</description>
</property>

<property>
    <name>mapreduce.jobhistory.joblist.cache.size</name>
    <value>1000</value>
    <description>作业列表缓存大小</description>
</property>



<property>
    <name>mapreduce.map.memory.mb</name>
    <value>1024</value>
    <description>Map任务内存</description>
</property>

<property>
    <name>mapreduce.reduce.memory.mb</name>
    <value>2048</value>
    <description>Reduce任务内存</description>
</property>

<property>
    <name>mapreduce.map.cpu.vcores</name>
    <value>1</value>
    <description>Map任务CPU核心数</description>
</property>

<property>
    <name>mapreduce.reduce.cpu.vcores</name>
    <value>1</value>
    <description>Reduce任务CPU核心数</description>
</property>

<property>
    <name>mapreduce.task.io.sort.mb</name>
    <value>256</value>
    <description>排序缓冲区大小（MB）</description>
</property>

<property>
    <name>mapreduce.task.io.sort.factor</name>
    <value>100</value>
    <description>排序时合并文件流数量</description>
</property>

<property>
    <name>mapreduce.reduce.shuffle.parallelcopies</name>
    <value>20</value>
    <description>Reduce并行复制数量</description>
</property>



<property>
    <name>mapreduce.map.output.compress</name>
    <value>true</value>
    <description>启用Map输出压缩</description>
</property>

<property>
    <name>mapreduce.map.output.compress.codec</name>
    <value>org.apache.hadoop.io.compress.SnappyCodec</value>
    <description>Map输出压缩编解码器</description>
</property>

<property>
    <name>mapreduce.output.fileoutputformat.compress</name>
    <value>false</value>
    <description>是否压缩最终输出</description>
</property>

<property>
    <name>mapreduce.output.fileoutputformat.compress.codec</name>
    <value>org.apache.hadoop.io.compress.GzipCodec</value>
    <description>最终输出压缩编解码器</description>
</property>

<property>
    <name>mapreduce.output.fileoutputformat.compress.type</name>
    <value>BLOCK</value>
    <description>压缩类型（BLOCK/RECORD）</description>
</property>



<property>
    <name>yarn.app.mapreduce.am.command-opts</name>
    <value>-Xmx1024m</value>
    <description>ApplicationMaster JVM选项</description>
</property>

<property>
    <name>yarn.app.mapreduce.am.resource.mb</name>
    <value>1024</value>
    <description>ApplicationMaster内存</description>
</property>

<property>
    <name>yarn.app.mapreduce.am.resource.cpu-vcores</name>
    <value>1</value>
    <description>ApplicationMaster CPU核心数</description>
</property>



<property>
    <name>mapreduce.job.speculative.speculativecap</name>
    <value>0.1</value>
    <description>推测执行任务比例上限</description>
</property>

<property>
    <name>mapreduce.job.ubertask.enable</name>
    <value>false</value>
    <description>是否启用Uber任务（小任务优化）</description>
</property>

<property>
    <name>mapreduce.job.maxtaskfailures.per.tracker</name>
    <value>3</value>
    <description>每个任务最大失败次数</description>
</property>

</configuration>
