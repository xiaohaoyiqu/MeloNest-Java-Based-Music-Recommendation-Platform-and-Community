# =============================================================================
# 浩然音乐平台 - MySQL 5.7.44 优化配置文件
# @author xiaohaoyiqu
# @date 2026-02-17
# @description 适配 yum 安装方式，使用默认数据目录，优化音乐平台性能
# @usage 复制到 /etc/my.cnf，然后执行 systemctl restart mysqld
# =============================================================================

[client]
port = 3306
socket = /var/lib/mysql/mysql.sock

[mysqld]
# =============================================================================
# 一、基础配置
# =============================================================================

# 服务器唯一标识（集群环境需不同）
server-id = 1

# 数据目录（使用yum安装默认路径）
datadir = /var/lib/mysql

# Socket文件位置（yum安装默认路径）
socket = /var/lib/mysql/mysql.sock

# PID文件位置
pid-file = /var/run/mysqld/mysqld.pid

# 运行用户
user = mysql

# 服务端口
port = 3306

# 字符集（使用utf8mb4支持emoji等字符）
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4'

# 时区（北京时间）
default-time-zone = '+8:00'

# 表名大小写不敏感（Linux推荐1，与Windows保持一致）
lower_case_table_names = 1

# 跳过域名解析（提升连接速度）
skip_name_resolve = 1

# 禁用符号链接（安全考虑）
symbolic-links = 0

# =============================================================================
# 二、网络连接配置
# =============================================================================

# 最大连接数（根据业务调整，音乐平台并发适中）
max_connections = 500

# 最大允许错误连接数
max_connect_errors = 10000

# 连接超时时间（秒）
wait_timeout = 28800
interactive_timeout = 28800

# 最大允许数据包（大SQL如批量导入需要）
max_allowed_packet = 64M

# =============================================================================
# 三、内存配置（根据16GB内存服务器优化）
# =============================================================================

# InnoDB缓冲池大小（物理内存的25%-50%，设为4G适配生产环境）
innodb_buffer_pool_size = 4G

# 缓冲池实例数（减少锁竞争）
innodb_buffer_pool_instances = 4

# InnoDB日志缓冲区
innodb_log_buffer_size = 16M

# MyISAM键缓冲区（音乐平台主要用InnoDB，设较小值）
key_buffer_size = 128M

# 表缓存
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 65535

# 临时表大小（用于复杂查询、排序）
tmp_table_size = 256M
max_heap_table_size = 256M

# =============================================================================
# 四、InnoDB存储引擎配置
# =============================================================================

# 日志文件大小（恢复速度与性能平衡）
innodb_log_file_size = 256M

# 日志文件组数量
innodb_log_files_in_group = 2

# 日志写入策略（2：每秒写入，性能与安全平衡）
innodb_flush_log_at_trx_commit = 2

# 刷盘方式（O_DIRECT：避免双重缓冲，提升性能）
innodb_flush_method = O_DIRECT

# 独立表空间（每个表一个文件，便于管理）
innodb_file_per_table = 1

# 死锁检测
innodb_deadlock_detect = ON

# 锁等待超时（秒）
innodb_lock_wait_timeout = 50

# IO线程数
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# IO能力（普通硬盘）
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# 并发线程数（0表示自动调整）
innodb_thread_concurrency = 0

# 自适应哈希索引
innodb_adaptive_hash_index = 1

# 脏页刷新策略
innodb_max_dirty_pages_pct = 75
innodb_max_dirty_pages_pct_lwm = 50

# =============================================================================
# 五、查询优化配置
# =============================================================================

# 查询缓存（MySQL 5.7推荐禁用，8.0已移除）
query_cache_type = 0
query_cache_size = 0

# 排序缓冲区（每个连接独立）
sort_buffer_size = 4M

# 读取缓冲区
read_buffer_size = 2M
read_rnd_buffer_size = 4M

# 连接缓冲区
join_buffer_size = 4M

# 线程栈大小
thread_stack = 256K

# 批量插入缓存大小
bulk_insert_buffer_size = 8M

# =============================================================================
# 六、慢查询日志配置
# =============================================================================

# 开启慢查询日志
slow_query_log = 1

# 慢查询日志文件（系统默认路径）
slow_query_log_file = /var/log/mysqld-slow.log

# 慢查询阈值（秒）
long_query_time = 2

# 记录未使用索引的查询
log_queries_not_using_indexes = 1

# 不记录管理语句
log_slow_admin_statements = 0

# =============================================================================
# 七、错误日志与通用日志
# =============================================================================

# 错误日志（系统默认路径）
log_error = /var/log/mysqld.log

# 错误日志记录警告
log_error_verbosity = 2

# 通用日志（生产环境建议关闭）
general_log = 0
general_log_file = /var/log/mysql-general.log

# =============================================================================
# 八、二进制日志配置
# =============================================================================

# 开启二进制日志（默认数据目录下）
log_bin = mysql-bin

# binlog格式（ROW：最安全，支持数据恢复）
binlog_format = ROW

# binlog过期天数
expire_logs_days = 7

# 单个binlog文件大小
max_binlog_size = 100M

# binlog同步策略（每N个事务同步一次）
sync_binlog = 10

# GTID模式（主从复制推荐）
gtid_mode = ON
enforce_gtid_consistency = ON

# binlog缓存大小
binlog_cache_size = 2M

# =============================================================================
# 九、复制配置（如需主从复制）
# =============================================================================

# 中继日志
relay_log = relay-bin
relay_log_recovery = 1
relay_log_purge = 1

# =============================================================================
# 十、其他优化
# =============================================================================

# 本地加载文件（安全考虑设为0）
local_infile = 0

# 事件调度器（定时任务）
event_scheduler = ON

# SQL模式（严格模式）
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# 存储引擎
default_storage_engine = InnoDB

# =============================================================================
# 十一、音乐平台专用优化
# =============================================================================

# 全文搜索最小词长度（中文搜索优化）
ft_min_word_len = 1

# 全文搜索分词（中文支持）
ngram_token_size = 2

# 连续内存分配（大内存服务器优化）
performance_schema = ON

# =============================================================================
# [mysqldump] - 备份工具配置
# =============================================================================

[mysqldump]
quick
max_allowed_packet = 64M
single-transaction
master-data = 2

# =============================================================================
# [mysql] - 客户端配置
# =============================================================================

[mysql]
no-auto-rehash
default-character-set = utf8mb4

# =============================================================================
# [myisamchk] - MyISAM修复工具配置
# =============================================================================

[myisamchk]
key_buffer_size = 128M
sort_buffer_size = 4M
read_buffer = 2M
write_buffer = 2M
