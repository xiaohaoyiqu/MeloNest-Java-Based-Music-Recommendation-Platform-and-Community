<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
























<configuration>



<property>
  <name>dfs.replication</name>
  <value>3</value>
  <description>HDFS数据块副本数</description>
</property>

<property>
  <name>dfs.blocksize</name>
  <value>268435456</value>
  <description>HDFS数据块大小（256MB - 适合大文件音乐存储）</description>
</property>



<property>
  <name>dfs.namenode.name.dir</name>
  <value>/sdb1/hdfsdata/namenode</value>
  <description>NameNode元数据存储目录</description>
</property>

<property>
  <name>dfs.datanode.data.dir</name>
  <value>/sdb1/hdfsdata/datanode</value>
  <description>DataNode数据存储目录</description>
</property>

<property>
  <name>dfs.namenode.checkpoint.dir</name>
  <value>/sdb1/hdfsdata/namesecondary</value>
  <description>SecondaryNameNode/NameNode检查点存储目录</description>
</property>

<property>
  <name>dfs.namenode.http-address</name>
  <value>0.0.0.0:9870</value>
  <description>NameNode Web UI地址</description>
</property>

<property>
  <name>dfs.namenode.handler.count</name>
  <value>100</value>
  <description>NameNode处理线程数（默认10，调高以提升并发）</description>
</property>

<property>
  <name>dfs.namenode.service.handler.count</name>
  <value>50</value>
  <description>NameNode服务处理器线程数</description>
</property>



<property>
  <name>dfs.data.transfer.transferTo.allowed</name>
  <value>true</value>
  <description>启用零拷贝传输（提高性能）</description>
</property>

<property>
  <name>dfs.datanode.use.datanode.hostname</name>
  <value>false</value>
  <description>使用IP而非主机名通信</description>
</property>

<property>
  <name>dfs.node.startup.metrics.duty.interval</name>
  <value>10</value>
  <description>启动时指标收集周期（秒）</description>
</property>

<property>
  <name>dfs.heartbeat.interval</name>
  <value>3</value>
  <description>心跳间隔（秒），缩短可更快检测故障</description>
</property>



<property>
  <name>dfs.domain.socket.path</name>
  <value>/sdb1/hdfsdata/dn_socket/dn_socket</value>
  <description>域套接字路径（短路读取优化 - 浩然音乐平台自定义路径）</description>
</property>

<property>
  <name>dfs.client.read.shortcircuit</name>
  <value>true</value>
  <description>启用短路读取（绕过网络直接读本地数据）</description>
</property>

<property>
  <name>dfs.client.read.shortcircuit.skip.checksum</name>
  <value>false</value>
  <description>短路读取是否跳过校验和</description>
</property>

<property>
  <name>dfs.domain.socket.data.traffic</name>
  <value>true</value>
  <description>域套接字数据流量</description>
</property>



<property>
  <name>dfs.namenode.fs-limits.max-component-length</name>
  <value>255</value>
  <description>路径最大组件长度</description>
</property>

<property>
  <name>dfs.namenode.fs-limits.max-directory-items</name>
  <value>1048576</value>
  <description>目录最大项目数</description>
</property>

<property>
  <name>dfs.namenode.accesstime.precision</name>
  <value>0</value>
  <description>访问时间精度（0=禁用，减少元数据更新）</description>
</property>

<property>
  <name>dfs.namenode.ls.openlimit</name>
  <value>4096</value>
  <description>list操作打开文件限制</description>
</property>



<property>
  <name>dfs.nameservices</name>
  <value>mycluster</value>
  <description>HDFS服务名称（HA集群标识）</description>
</property>

<property>
  <name>dfs.ha.namenodes.mycluster</name>
  <value>nn1,nn2</value>
  <description>NameNodes列表</description>
</property>



<property>
  <name>dfs.namenode.rpc-address.mycluster.nn1</name>
  <value>192.168.153.131:8020</value>
  <description>NameNode nn1 RPC地址</description>
</property>

<property>
  <name>dfs.namenode.http-address.mycluster.nn1</name>
  <value>192.168.153.131:9870</value>
  <description>NameNode nn1 Web UI地址</description>
</property>

<property>
  <name>dfs.namenode.https-address.mycluster.nn1</name>
  <value>192.168.153.131:9871</value>
  <description>NameNode nn1 HTTPS地址</description>
</property>



<property>
  <name>dfs.namenode.rpc-address.mycluster.nn2</name>
  <value>192.168.153.132:8020</value>
  <description>NameNode nn2 RPC地址</description>
</property>

<property>
  <name>dfs.namenode.http-address.mycluster.nn2</name>
  <value>192.168.153.132:9870</value>
  <description>NameNode nn2 Web UI地址</description>
</property>

<property>
  <name>dfs.namenode.https-address.mycluster.nn2</name>
  <value>192.168.153.132:9871</value>
  <description>NameNode nn2 HTTPS地址</description>
</property>



<property>
  <name>dfs.journalnode.edits.dir</name>
  <value>/sdb1/hdfsdata/journalnode</value>
  <description>JournalNode编辑日志存储目录</description>
</property>

<property>
  <name>dfs.namenode.shared.edits.dir</name>
  <value>qjournal://192.168.153.131:8485;192.168.153.132:8485;192.168.153.133:8485/mycluster</value>
  <description>JournalNode集群地址（端口需开放8485）</description>
</property>



<property>
  <name>dfs.ha.automatic-failover.enabled</name>
  <value>true</value>
  <description>启用自动故障转移</description>
</property>

<property>
  <name>dfs.client.failover.proxy.provider.mycluster</name>
  <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  <description>故障转移代理Provider</description>
</property>

<property>
  <name>dfs.ha.fencing.methods</name>
  <value>sshfence</value>
  <description>隔离方式（SSH方式）</description>
</property>

<property>
  <name>dfs.ha.fencing.ssh.private-key-files</name>
  <value>/home/hdfs/.ssh/id_rsa</value>
  <description>SSH免密私钥路径（需配置免密登录）</description>
</property>

<property>
  <name>dfs.ha.fencing.ssh.connect-timeout</name>
  <value>30000</value>
  <description>SSH连接超时（毫秒）</description>
</property>



<property>
  <name>ha.zookeeper.quorum</name>
  <value>192.168.153.131:2181,192.168.153.132:2181,192.168.153.133:2181</value>
  <description>ZooKeeper集群地址</description>
</property>

<property>
  <name>dfs.zk.address</name>
  <value>192.168.153.131:2181,192.168.153.132:2181,192.168.153.133:2181</value>
  <description>ZooKeeper地址（ZKFC使用）</description>
</property>

<property>
  <name>dfs.zk.fc.timeout.millis</name>
  <value>30000</value>
  <description>ZKFC会话超时（毫秒）</description>
</property>



<property>
  <name>dfs.safemode.threshold.pct</name>
  <value>0.999</value>
  <description>安全模式数据块阈值（降低可更快退出）</description>
</property>

<property>
  <name>dfs.safemode.extension</name>
  <value>10000</value>
  <description>安全模式扩展时间（毫秒）</description>
</property>

<property>
  <name>dfs.safemode.min.datanodes</name>
  <value>0</value>
  <description>进入安全模式的最小DataNode数</description>
</property>

<property>
  <name>dfs.permissions.enabled</name>
  <value>false</value>
  <description>禁用权限检查（开发环境）</description>
</property>



<property>
  <name>dfs.namenode.secondary.http-address</name>
  <value>192.168.153.132:50090</value>
  <description>SecondaryNameNode HTTP地址（兼容旧版）</description>
</property>



<property>
  <name>dfs.webhdfs.enabled</name>
  <value>true</value>
  <description>启用WebHDFS</description>
</property>

<property>
  <name>dfs.journalnode.rpc-address</name>
  <value>0.0.0.0:8485</value>
  <description>JournalNode RPC地址</description>
</property>



<property>
  <name>dfs.client.block.write.replace-datanode-on-failure.policy</name>
  <value>DEFAULT</value>
  <description>写失败时替换DataNode策略</description>
</property>

<property>
  <name>dfs.client.block.write.replace-datanode-on-failure.best-effort</name>
  <value>true</value>
  <description>写失败时尽力替换DataNode</description>
</property>

<property>
  <name>dfs.image.compress</name>
  <value>true</value>
  <description>压缩FSImage文件</description>
</property>

<property>
  <name>dfs.image.compression.codec</name>
  <value>org.apache.hadoop.io.compress.SnappyCodec</value>
  <description>FSImage压缩算法</description>
</property>

<property>
  <name>dfs.namenode.image.transfer.bandwidthPerSec</name>
  <value>10485760</value>
  <description>镜像传输带宽限制（字节/秒，10MB/s）</description>
</property>

<property>
  <name>dfs.stream.buffer-size</name>
  <value>1048576</value>
  <description>流缓冲区大小（1MB）</description>
</property>

<property>
  <name>dfs.bytes-per-checksum</name>
  <value>512</value>
  <description>校验和计算字节间隔</description>
</property>

</configuration>
